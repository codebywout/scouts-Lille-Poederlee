Options -Indexes
DirectoryIndex page.php

# Raise upload limits when Apache + mod_php is used.
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>

# Fresh HTML shell; versioned CSS/JS (?v=) may be cached long-term.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"

    <FilesMatch "\.(?:html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <!-- Sitemap is rewritten to sitemap.php; allow short public cache for crawlers. -->
    <Files "sitemap.php">
        Header unset Pragma
        Header unset Expires
        Header set Cache-Control "public, max-age=3600"
    </Files>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <!-- Versioned images/fonts (?v=) can be cached long-term for repeat visits. -->
    <FilesMatch "\.(?:avif|webp|jpe?g|png|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,END]

# Dynamic CSS entrypoint so @import URLs always carry the current asset version.
RewriteRule ^assets/css/style\.css$ assets/css/style.php [END,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [END]

RewriteRule ^login/?$ page.php?page=login [END,QSA]
RewriteRule ^admin/?$ admin-gate.php [END]
RewriteRule ^404/?$ page.php?page=404 [END,QSA]
RewriteRule ^index\.html$ / [R=301,END]
RewriteRule ^admin/index\.html$ /admin [R=301,END]
RewriteRule ^admin\.html$ /admin [R=301,END]
RewriteRule ^login\.html$ /login [R=301,END]
RewriteRule ^privacybeleid/?$ page.php?page=privacybeleid [END,QSA]
RewriteRule ^privacybeleid\.html$ /privacybeleid [R=301,END]
RewriteRule ^privacyverklaring/?$ /privacybeleid [R=301,END]
RewriteRule ^privacyverklaring\.html$ /privacybeleid [R=301,END]
RewriteRule ^pages/privacyverklaring\.html$ /privacybeleid [R=301,END]
RewriteRule ^pages/(over-ons|inschrijven|jins|jongverkenners|kapoenen|nieuws|tweedehands|uniform|verkenners|welpen)\.html$ /$1 [R=301,END]
RewriteRule ^(over-ons|inschrijven|jins|jongverkenners|kapoenen|nieuws|tweedehands|uniform|verkenners|welpen)\.html$ /$1 [R=301,END]
RewriteRule ^(over-ons|inschrijven|jins|jongverkenners|kapoenen|nieuws|tweedehands|uniform|verkenners|welpen)/?$ page.php?page=$1 [END,QSA]
RewriteRule ^$ page.php?page=index [END,QSA]
RewriteRule ^data(?:/|$) - [F,END]
RewriteRule ^includes(?:/|$) - [F,END]
RewriteRule ^tools(?:/|$) - [F,END]
RewriteRule ^uploads/originals(?:/|$) - [F,END]
RewriteRule ^(?:\.env|\.git|node_modules)(?:/|$) - [F,END]
RewriteRule ^(?:config\.php|router\.php|google-drive\.php|server(?:/|$)|sitemap\.php) - [F,END]
RewriteRule ^auth-config\.php$ - [F,END]

# Unknown public paths → styled 404 (keeps HTTP 404 via page.php).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|assets|uploads)/
RewriteRule ^ page.php?page=404 [END,QSA]

<FilesMatch "^(?:config\.php|router\.php|google-drive\.php|auth-config\.php|Dockerfile|docker-compose\.yml|package(?:-lock)?\.json)$">
    Require all denied
</FilesMatch>
