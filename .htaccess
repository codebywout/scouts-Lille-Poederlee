Options -Indexes
DirectoryIndex page.php

# Raise upload limits when Apache + mod_php is used.
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>

# Always prefer a fresh HTML shell; CSS/JS must revalidate.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,END]

# Dynamic CSS entrypoint so @import URLs always carry the current asset version.
RewriteRule ^assets/css/style\.css$ assets/css/style.php [END,QSA]

RewriteRule ^login/?$ page.php?page=login [END,QSA]
RewriteRule ^admin/?$ admin-gate.php [END]
RewriteRule ^index\.html$ / [R=301,END]
RewriteRule ^admin/index\.html$ /admin [R=301,END]
RewriteRule ^admin\.html$ /admin [R=301,END]
RewriteRule ^login\.html$ /login [R=301,END]
RewriteRule ^privacybeleid/?$ page.php?page=privacybeleid [END,QSA]
RewriteRule ^privacybeleid\.html$ /privacybeleid [R=301,END]
RewriteRule ^privacyverklaring/?$ /privacybeleid [R=301,END]
RewriteRule ^privacyverklaring\.html$ /privacybeleid [R=301,END]
RewriteRule ^pages/privacyverklaring\.html$ /privacybeleid [R=301,END]
RewriteRule ^pages/(over-ons|inschrijven|jins|jongverkenners|kapoenen|nieuws|tweedehands|uniform|verkenners|welpen)\.html$ /$1 [R=301,END]
RewriteRule ^(over-ons|inschrijven|jins|jongverkenners|kapoenen|nieuws|tweedehands|uniform|verkenners|welpen)\.html$ /$1 [R=301,END]
RewriteRule ^(over-ons|inschrijven|jins|jongverkenners|kapoenen|nieuws|tweedehands|uniform|verkenners|welpen)/?$ page.php?page=$1 [END,QSA]
RewriteRule ^$ page.php?page=index [END,QSA]
RewriteRule ^data(?:/|$) - [F,END]
RewriteRule ^(?:\.env|\.git|node_modules)(?:/|$) - [F,END]
RewriteRule ^(?:config\.php|router\.php|server(?:/|$)) - [F,END]
RewriteRule ^auth-config\.php$ - [F,END]

<FilesMatch "^(?:config\.php|router\.php|auth-config\.php|Dockerfile|docker-compose\.yml|package(?:-lock)?\.json)$">
    Require all denied
</FilesMatch>
