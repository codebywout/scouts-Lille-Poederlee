# Kopieer dit bestand naar `.env` en vul de waarden in.
# Commit nooit een echte `.env`, auth-config.php of password-hash van productie.
#
# Alternatief: auth-config.php (ook in .gitignore) met constanten
# SCOUTS_AUTH_USERNAME / SCOUTS_AUTH_PASSWORD_HASH.

# --- Verplicht voor admin-login ---
# Gebruikersnaam van het beheeraccount.
SCOUTS_ADMIN_USERNAME=admin

# bcrypt/argon2-hash van het wachtwoord (via password_hash in PHP).
# Leeg laten = login werkt niet tot je een hash instelt.
# Voorbeeld genereren:
#   php -r "echo password_hash('KIES-EEN-STERK-WACHTWOORD', PASSWORD_DEFAULT), PHP_EOL;"
SCOUTS_ADMIN_PASSWORD_HASH=

# --- Optioneel: apart wachtwoord voor Google Drive-instellingen in de admin ---
# Zonder deze hash blijft de Drive-instellingen-UI vergrendeld (tenzij elders geconfigureerd).
# SCOUTS_GOOGLE_SETTINGS_PASSWORD_HASH=

# --- Optioneel: pad naar Google service-account JSON (alleen als je Drive gebruikt) ---
# Absoluut pad of pad relatief aan de projectroot. Bestanden met private keys horen
# NIET in Git (zie .gitignore: data/.google-service-account.json).
# SCOUTS_GOOGLE_SERVICE_ACCOUNT_JSON_PATH=data/.google-service-account.json

# --- Optioneel: wekelijkse site-data backup naar Google Drive ---
# Minimaal 16 tekens. Nodig voor GET/POST /api/cron/backup-drive
# (header X-Scouts-Cron-Secret of ?token=...). Of gebruik CLI:
#   php tools/backup-site-data-to-drive.php
# SCOUTS_CRON_SECRET=
# Standaardmap: 1d494gLWlxCcxmUN7b9TdPer1IbliEp_6
# SCOUTS_GOOGLE_DRIVE_BACKUP_FOLDER_ID=1d494gLWlxCcxmUN7b9TdPer1IbliEp_6
